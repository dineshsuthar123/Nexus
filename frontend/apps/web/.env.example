# =============================================================================
# Nexus RTP Platform - Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Base URL for the backend API (Kong Gateway)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8089/ws

# Kong proxy URL (same as API_URL for local dev)
NEXT_PUBLIC_KONG_PROXY=http://localhost:8000

# -----------------------------------------------------------------------------
# NextAuth.js Configuration
# -----------------------------------------------------------------------------
# The canonical URL of your site
NEXTAUTH_URL=http://localhost:3000

# Secret used to encrypt session tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# JWT expiration times (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable mock mode for development without backend
NEXT_PUBLIC_MOCK_MODE=false

# Enable real-time WebSocket features
NEXT_PUBLIC_ENABLE_REALTIME=true

# Enable MFA features
NEXT_PUBLIC_ENABLE_MFA=true

# Auth Service Configuration
SERVICE_NAME=auth-service
VERSION=1.0.0
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=debug

# CockroachDB
DATABASE_URL=postgresql://root@localhost:26257/nexus_auth?sslmode=disable

# Redis (for session storage, rate limiting)
REDIS_URL=redis://localhost:6379

# Jaeger tracing
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# JWT Configuration (RS256)
# TODO: In production, use Vault/HSM-backed keys. These are DEV-ONLY keys.
JWT_PRIVATE_KEY_PATH=./keys/dev_private.pem
JWT_PUBLIC_KEY_PATH=./keys/dev_public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ISSUER=nexus-rtp-auth
JWT_PASSWORD_RESET_EXPIRY=1h

# MFA Configuration
MFA_ISSUER=NexusRTP
# TODO: Replace with Vault-backed secret in production (must be exactly 32 bytes for AES-256)
MFA_ENCRYPTION_KEY=PLACEHOLDER_32_BYTE_KEY_REPLACE_

# =============================================================================
# Nexus RTP — Production Environment Variables
# For free-tier VPS deployment (Oracle Cloud / Hetzner / etc.)
# =============================================================================

# ---- General ----
TZ=UTC
LOG_LEVEL=info

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_HERE

# ---- MFA ----
MFA_ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_BYTES_AES256

# ---- Kong ----
KONG_PG_PASSWORD=CHANGE_ME_KONG_DB_PASSWORD

# ---- Grafana ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ---- Container Registry ----
# ghcr.io is free for public repos
REGISTRY=ghcr.io
GITHUB_REPOSITORY_OWNER=YOUR_GITHUB_USERNAME
VERSION=latest

# =============================================================================
# Nexus RTP Platform — Root Environment Variables
# Copy to .env and fill in values for local development
# =============================================================================

# ---- General ----
TZ=UTC
LOG_LEVEL=debug

# ---- CockroachDB ----
DATABASE_URL=postgresql://root@localhost:26257/nexus_ledger?sslmode=disable

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Idempotency (shared across services) ----
IDEMPOTENCY_TTL_SECONDS=86400

# ---- Auth / JWT ----
JWT_PRIVATE_KEY_PATH=./keys/dev_private.pem
JWT_PUBLIC_KEY_PATH=./keys/dev_public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ISSUER=nexus-rtp-auth
JWT_PASSWORD_RESET_EXPIRY=1h

# ---- MFA ----
MFA_ISSUER=NexusRTP
# Must be exactly 32 bytes for AES-256. Replace in production with Vault-backed secret.
MFA_ENCRYPTION_KEY=PLACEHOLDER_32_BYTE_KEY_REPLACE_

# ---- Observability ----
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ---- OFAC / Sanctions ----
WATCHMAN_URL=http://localhost:8084

# ---- Multi-tenancy ----
# Default tenant UUID for single-tenant mode (set to a real UUID in multi-tenant deployments)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
REQUIRE_TENANT_ID=false

# ---- Kong API Gateway ----
KONG_PG_PASSWORD=CHANGE_ME_KONG_PASSWORD

# ---- Grafana ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ---- Container Registry (for build-images.sh) ----
REGISTRY=ghcr.io
